# ─── Database ────────────────────────────────────────────────────────────────
# Local dev (matches docker-compose.yml defaults):
DATABASE_URL=postgres://lex:lexpassword@localhost:5432/lex_superior

# ─── API Server ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Claude API (required — primary AI provider) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Google Drive OAuth2 (required for private Drive file ingestion) ──────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000/api/training/drive-callback as an authorised redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Populated automatically after first OAuth login — copy from server logs
GOOGLE_REFRESH_TOKEN=

# ─── Google API Key (public Drive files fallback, optional) ───────────────────
GOOGLE_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# In a separate terminal / .env for lex-superior:
# PORT=5173
# BASE_PATH=/

# ─── Optional AI providers (fallbacks if Claude is unavailable) ───────────────
COZE_API_TOKEN=
COZE_BOT_ID=
DIFY_API_KEY=
DIFY_API_BASE_URL=https://api.dify.ai/v1
